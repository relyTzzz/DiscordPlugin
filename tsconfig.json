{
  // esbuild resolves this plugin via a junction to its real path here (outside
  // the Vencord checkout), so it walks up to THIS tsconfig for path aliases.
  // These point at the sibling Vencord checkout (see README / link script).
  // No "baseUrl": it is deprecated in TypeScript 6.0 and removed in 7.0; since
  // TS 4.4 "paths" entries resolve relative to this file, so they carry the
  // ../Vencord prefix themselves.
  "compilerOptions": {
    "paths": {
      "@main/*": ["../Vencord/src/main/*"],
      "@api/*": ["../Vencord/src/api/*"],
      "@components/*": ["../Vencord/src/components/*"],
      "@debug/*": ["../Vencord/src/debug/*"],
      "@utils/*": ["../Vencord/src/utils/*"],
      "@plugins/*": ["../Vencord/src/plugins/*"],
      "@shared/*": ["../Vencord/src/shared/*"],
      "@webpack/common": ["../Vencord/src/webpack/common"],
      "@webpack/common/*": ["../Vencord/src/webpack/common/*"],
      "@webpack": ["../Vencord/src/webpack/webpack"],
      "@webpack/patcher": ["../Vencord/src/webpack/patchWebpack"],
      "@webpack/wreq.d": ["../Vencord/src/webpack/wreq.d"],
      "@webpack/types": ["../Vencord/src/webpack/types"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "types": []
  },
  "include": ["src/**/*"]
}
