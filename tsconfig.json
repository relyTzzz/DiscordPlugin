{
  // esbuild resolves this plugin via a junction to its real path here (outside
  // the Vencord checkout), so it walks up to THIS tsconfig for path aliases.
  // baseUrl points at the sibling Vencord checkout (see README / link script).
  "compilerOptions": {
    "baseUrl": "../Vencord",
    "paths": {
      "@main/*": ["./src/main/*"],
      "@api/*": ["./src/api/*"],
      "@components/*": ["./src/components/*"],
      "@debug/*": ["./src/debug/*"],
      "@utils/*": ["./src/utils/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@shared/*": ["./src/shared/*"],
      "@webpack/common": ["./src/webpack/common"],
      "@webpack/common/*": ["./src/webpack/common/*"],
      "@webpack": ["./src/webpack/webpack"],
      "@webpack/patcher": ["./src/webpack/patchWebpack"],
      "@webpack/wreq.d": ["./src/webpack/wreq.d"],
      "@webpack/types": ["./src/webpack/types"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["standalone-electron-types"]
  },
  "include": ["src/**/*"]
}
